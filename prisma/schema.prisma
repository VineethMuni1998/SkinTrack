// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoutineTimeOfDay {
  MORNING
  NIGHT
  BOTH
}

enum SkinType {
  DRY
  OILY
  COMBINATION
  NORMAL
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  emailVerified DateTime?
  image         String?
  age           Int?
  dateOfBirth   DateTime?
  skinType      SkinType?
  createdAt     DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  accounts      Account[]
  sessions      Session[]
  routines      Routine[]
  photos        Photo[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  brand       String?
  ingredients String?  @db.Text
  category    String?
  createdAt   DateTime @default(now())
  
  routineProducts RoutineProduct[]
}

model Routine {
  id        String   @id @default(cuid())
  userId    String
  name      String?
  startDate DateTime @default(now())
  status    String   @default("active") // active, completed, paused
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineProducts RoutineProduct[]
  photos         Photo[]
  analyses       Analysis[]
}

model RoutineProduct {
  id                      String   @id @default(cuid())
  routineId               String
  productId               String
  addedAt                 DateTime @default(now())
  removedAt               DateTime?
  removalReason           String?  @db.Text  // Optional reason for ending the product
  timeOfDay               RoutineTimeOfDay @default(MORNING)
  expectedResultsTimeframe String?  // Manual override for expected results timeframe (e.g., "2-4 weeks")
  stepOrder               Int      @default(0)
  skipDays                String[] @default([]) // Days of week to skip (e.g., ["TUESDAY","THURSDAY"])
  
  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@unique([routineId, productId, addedAt])
}

model Photo {
  id              String   @id @default(cuid())
  userId          String
  routineId       String?
  routineProductId String?  // Associate photo with specific product
  url             String
  type            String   // "before" or "after"
  note            String?  @db.Text
  takenAt         DateTime @default(now())
  createdAt       DateTime @default(now())
  
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine Routine? @relation(fields: [routineId], references: [id], onDelete: Cascade)
}

model Analysis {
  id             String   @id @default(cuid())
  routineId      String
  products       Json     // Array of product IDs and names
  timeline       Json     // Timeline for each product
  interactions   Json     // Product interactions analysis
  recommendations Json    // AI recommendations
  createdAt      DateTime @default(now())
  
  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
}
